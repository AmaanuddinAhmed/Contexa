# Copy to .env.local for local development. Never commit real values.
# On Vercel, set these under Project -> Settings -> Environment Variables.

# MongoDB connection string. Local: mongodb://127.0.0.1:27017/contexa
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/contexa?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/contexa

# Secret used to sign login tokens. Use a long random value in production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Python recommendation service (recommendation-service/).
RECOMMENDATION_SERVICE_URL=http://localhost:8000

# Shared secret sent as X-Internal-Key. Must equal INTERNAL_API_KEY on the
# recommendation service. Leave empty locally to disable the check.
INTERNAL_API_KEY=

# Milliseconds to wait for the recommendation service (default 10000).
# Set to 60000 in production: a free-tier service can take ~1 min to wake.
RECOMMENDATION_SERVICE_TIMEOUT_MS=10000

# Optional tuning for candidate generation (defaults: 500 and 5000).
# CANDIDATE_POOL_LIMIT=500
# CANDIDATE_SCAN_LIMIT=5000


# Google sign-in (Google Cloud Console -> Google Auth Platform -> Clients).
# If empty, "Continue with Google" shows a "not set up yet" message.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public base URL used to build the redirect URI
# (<APP_URL>/api/v1/auth/google/callback). Set it on Vercel to your
# production URL so preview deployments use the registered URI too.
# Leave empty locally (the request's own origin is used).
APP_URL=