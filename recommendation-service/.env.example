# Environment for the recommendation service. On Render, set these under
# the service's Environment tab. Never commit real values.

# Shared secret; callers must send it as the X-Internal-Key header.
# Must equal INTERNAL_API_KEY in the web app. Unset = no check (local only).
# REQUIRED in production (min 32 characters): the service will not start on
# Render, or with ENVIRONMENT=production, without it. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
INTERNAL_API_KEY=

# Set to "production" when deploying somewhere other than Render (Render is
# detected automatically). Production also hides /docs and /openapi.json.
# ENVIRONMENT=production

# Render only: pin the Python version (must be a full version, e.g. 3.14.3).
# PYTHON_VERSION=3.14.3

# Optional: a folder holding the embedding model (model.onnx + tokenizer
# files) to use instead of models/. Normally leave unset and run
# `python download_model.py` once.
# SEMANTIC_MODEL_PATH=